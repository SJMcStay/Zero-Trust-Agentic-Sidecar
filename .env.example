# ==============================================================================
# Zero-Trust Agentic Sidecar Configuration
# ==============================================================================

# Network address and port for the Rust proxy listener
SIDECAR_ADDR=127.0.0.1:8080

# External Anthropic API key injected into upstream requests inside Rust memory
# (Never exposed to client agents or logs)
ANTHROPIC_API_KEY=sk-ant-api03-example-demo-key

# Upstream LLM messages endpoint
UPSTREAM_LLM_URL=https://api.anthropic.com/v1/messages

# Target microservice backend URL (Python Flask)
FLASK_BACKEND_URL=http://127.0.0.1:5000

# Cryptographic signing secret for Sidecar -> Flask backend HMAC-SHA256 (REQUIRED)
# backend/app.py reads the same variable. scripts/init.sh generates fresh values.
SIDECAR_SECRET=super-secret-sidecar-signing-key-32-bytes-min!

# Cryptographic secret for verifying inbound agent Bearer JWTs (REQUIRED)
JWT_SECRET=super-secret-agent-jwt-key-32-bytes-min!

# Path to the zero-trust TOML policy file
POLICY_PATH=policy.toml

# Decision engine: http (Kev reference server, default) | candle (experimental, kev-0.8b only)
# | synthetic (toy graph for tests). The sidecar exits if the chosen engine cannot start.
KEV_ENGINE=http

# Kev reference server started by scripts/kev_server.sh
KEV_URL=http://127.0.0.1:8008

# Kev checkpoint, an entry in models.json: kev-4b (default, 32 GB RAM) or kev-0.8b (16 GB machines)
KEV_MODEL=kev-4b

# Tracing filter directive
RUST_LOG=zero_trust_agentic_sidecar=info,tower_http=debug
