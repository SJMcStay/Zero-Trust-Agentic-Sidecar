# =====================================================================
# Zero-Trust Agentic Sidecar — .gitignore
# =====================================================================

# ---------------------------------------------------------------------
# Rust / Cargo (Cargo.lock IS committed: this is a binary)
# ---------------------------------------------------------------------
/target/
**/target/
**/*.rs.bk
*.pdb
*.profraw
*.profdata
flamegraph.svg
perf.data*
/coverage/
lcov.info
tarpaulin-report.html
/criterion/

# ---------------------------------------------------------------------
# Secrets & crypto material. NEVER commit real keys.
# Test fixtures go under tests/fixtures/ (un-ignored below).
# ---------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.csr
*.p12
*.pfx
*.jks
*.der
id_rsa*
id_ed25519*
secrets/
/keys/
!tests/fixtures/**

# ---------------------------------------------------------------------
# Model weights: never in git. scripts/fetch_model.py downloads them
# (pinned + sha256-verified via models.json / models.lock.json, which ARE committed).
# ---------------------------------------------------------------------
/models/
**/models--*/
/.cache/
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.onnx
*.onnx_data
*.gguf
*.ggml
*.h5
*.msgpack
*.npz
*.tflite
*.ot
*.mlpackage/
*.mlmodelc/

# Kev reference server checkout + its Python env + link-only HF cache (scripts/kev_server.sh)
/.kev-server/

# ---------------------------------------------------------------------
# Python (backend + e2e venv)
# ---------------------------------------------------------------------
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Local policy with the real-model timeout (scripts/init.sh)
policy.local.toml

# Runtime logs / audit output (may contain captured prompts + payloads)
*.log
/logs/
/audit/
*.jsonl

# ---------------------------------------------------------------------
# AI coding tools
#   Claude Code: shared config is committed (CLAUDE.md, .mcp.json,
#   .claude/settings.json, agents/, commands/, skills/); the rest is personal.
#   Antigravity / Gemini / others: local state, never committed.
# ---------------------------------------------------------------------
.claude/*
!.claude/settings.json
!.claude/agents/
!.claude/commands/
!.claude/skills/
CLAUDE.local.md
*.original.md
.agent/
.agents/
.gemini/
.antigravity/
.antigravity-server/
.cursor/
.aider*
.codex/
.continue/

# ---------------------------------------------------------------------
# Editors / IDEs / OS / scratch
# ---------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.iml
*.swp
*.swo
*~
.history/
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
/tmp/
/scratch/
*.tmp
